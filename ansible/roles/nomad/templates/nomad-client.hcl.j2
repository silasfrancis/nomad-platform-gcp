# Managed By Ansible (nomad Role, Client Mode) — Only Written When
# nomad_mode == "client" (nomad-clients.yaml, Or Baked Via Packer For
# nomad-client-mig).
#
# node_pool_type/env/node_class client.meta Values Are NOT Set Here Even
# When Group Vars Are In Scope — They're Genuinely Per-MIG-Instance-
# Template (On-Demand Vs Spot Within The SAME Environment), Which Even
# dev.yaml/prod.yaml Can't Express. The GCP Startup Script Always Sets These
# In 99-instance.hcl, Regardless Of Whether This Role Ran Via Direct
# Ansible Or Via Packer.

client {
  enabled = true

  cni_path       = "/opt/cni/bin"
  cni_config_dir = "/etc/cni/net.d"
  
{% if retry_join is defined %}
  server_join {
    retry_join = {{ retry_join | to_json }}
  }
{% endif %}
}

plugin "docker" {
  config {
    enabled    = true
    allow_caps = ["chown", "net_raw", "net_bind_service"]
    volumes {
      enabled = true
    }
  }
}
