# Managed By Ansible (consul Role).
#
# datacenter/retry_join/bootstrap_expect Only Render When The Corresponding
# Group Vars Are Defined — True For Direct Runs Against Real Inventory
# Hosts (dev.yaml/prod.yaml Supply Them), False When Packer Bakes This Role
# Into The Shared nomad-client-mig Image Without Env-Specific Group Vars
# In Scope. In The Latter Case The GCP Startup Script Supplies Them and gossip encyption keys In
# 99-instance.hcl At Real Boot.

data_dir  = "{{ consul_data_dir }}"
log_level = "INFO"
log_file  = "{{ consul_log_dir }}/"

server = {{ 'true' if consul_mode == 'server' else 'false' }}

{% if consul_datacenter is defined %}
datacenter = "{{ consul_datacenter }}"
node_name  = "{{ inventory_hostname }}"

bind_addr      = "0.0.0.0"
client_addr    = "0.0.0.0"
advertise_addr = "{{ ansible_default_ipv4.address }}"
{% endif %}


tls {
  defaults {
    ca_file   = "{{ consul_tls_dir }}/ca.pem"
    cert_file = "{{ consul_tls_dir }}/cert.pem"
    key_file  = "{{ consul_tls_dir }}/key.pem"
    verify_incoming = true
    verify_outgoing = true
  }
  internal_rpc {
    verify_incoming        = true   # requires a client cert on RPC connections
    verify_server_hostname = true   # requires that cert to actually identify a server
  }
  https {
    verify_incoming = false  # API accepts server-verified-only clients (Traefik's rootCAs config)
  }
  grpc {
    verify_incoming = false  # Consul does not support incoming TLS verification of Envoy sidecars
  }

}

ui_config {
  enabled = true
}

connect {
  enabled = {{ consul_connect_enabled | lower }}
}

ports {
  server   = {{ consul_ports.server }}
  serf_lan = {{ consul_ports.serf_lan }}
  serf_wan = {{ consul_ports.serf_wan }}
  http     = {{ consul_ports.http }}
  https    = {{ consul_ports.https }}
  dns      = {{ consul_ports.dns }}
  grpc_tls = {{ consul_ports.grpc_tls }}
}

acl {
  enabled                  = {{ consul_acl_enabled | lower }}
  default_policy           = "{{ consul_acl_default_policy }}"
  enable_token_persistence = true
}

telemetry {
  prometheus_retention_time = "24h"
  disable_hostname          = true
}

performance {
  raft_multiplier = 1
}
