# Managed By Ansible (octopus Role) — Contains Secrets, Mode 0600.
#
# DB_CONNECTION_STRING Has The Real Password Embedded Directly Rather Than
# Referencing ${MSSQL_SA_PASSWORD} — Docker Compose Does Not Expand
# Variable References Nested Inside Another .env Value, Only When
# Substituting Into The Compose YAML Itself.

SQL_IMAGE={{ mssql_image }}
MSSQL_SA_PASSWORD={{ mssql_sa_password }}
ACCEPT_EULA=Y

OCTOPUS_SERVER_TAG={{ octopus_server_tag }}
ACCEPT_OCTOPUS_EULA=Y
OCTOPUS_SERVER_NODE_NAME={{ octopus_node_name }}
DB_CONNECTION_STRING=Server={{ mssql_container_name }},1433;Database=OctopusDeploy;User=sa;Password={{ mssql_sa_password }}
ADMIN_USERNAME={{ octopus_admin_username }}
ADMIN_PASSWORD={{ octopus_admin_password }}
ADMIN_EMAIL={{ octopus_admin_email }}
MASTER_KEY={{ octopus_master_key }}
ADMIN_API_KEY={{ octopus_admin_api_key }}
DISABLE_DIND={{ octopus_disable_dind }}
PRIVILEGED={{ octopus_privileged }}
USER={{ octopus_run_as_user }}
