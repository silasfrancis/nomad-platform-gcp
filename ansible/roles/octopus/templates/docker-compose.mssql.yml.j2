# Managed By Ansible (octopus Role, Step 1). ${MSSQL_SA_PASSWORD} Comes
# From {{ mssql_compose_dir }}/.env — Never Committed To Git.

services:
  mssql:
    image: {{ mssql_image }}
    container_name: {{ mssql_container_name }}
    restart: unless-stopped
    environment:
      ACCEPT_EULA: "Y"
      MSSQL_PID: "Express"
      SA_PASSWORD: "${MSSQL_SA_PASSWORD}"
    ports:
      - "127.0.0.1:1433:1433"
    volumes:
      - {{ mssql_data_dir }}:/var/opt/mssql
    healthcheck:
      test: ["CMD", "/opt/mssql-tools/bin/sqlcmd", "-S", "localhost", "-U", "sa", "-P", "${MSSQL_SA_PASSWORD}", "-Q", "SELECT 1"]
      interval: 30s
      timeout: 10s
      retries: 5
