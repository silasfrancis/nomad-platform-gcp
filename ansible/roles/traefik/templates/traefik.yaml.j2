# Managed By Ansible (traefik Role) — Instance: {{ traefik_instance.name }}

log:
  filePath: "{{ traefik_base_log_dir }}/{{ traefik_instance.name }}/traefik.log"
  level: INFO

entryPoints:
{% if traefik_instance.http_port %}
  web:
    address: ":{{ traefik_instance.http_port }}"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
{% endif %}
  websecure:
    address: ":{{ traefik_instance.https_port }}"
{% if traefik_instance.tcp_entrypoint %}
  {{ traefik_instance.tcp_entrypoint.name }}:
    address: ":{{ traefik_instance.tcp_entrypoint.port }}"
{% endif %}
{% if traefik_instance.internal_https_port %}
  # A Second, Separate HTTPS Listener — Deliberately Not Named
  # "websecure" (Every Other Instance's Own Entrypoint Uses That Name)
  # So An Internal-Only Service Tagged Onto This Entrypoint Can Never
  # Get Picked Up By A Public Instance Sharing The Same Consul Catalog.
  # See The internal_https_port Field Comment In defaults/main.yaml
  # For The Full Reasoning.
  internal:
    address: ":{{ traefik_instance.internal_https_port }}"
{% endif %}

{% if traefik_instance.metrics_port %}
  metrics:
    address: ":{{ traefik_instance.metrics_port }}"
{% endif %}

providers:
{% if traefik_instance.static_routes | length > 0 %}
  file:
    directory: "{{ traefik_base_config_dir }}/{{ traefik_instance.name }}/dynamic"
    watch: true
{% endif %}
{% if catalog_enabled %}
  # This Environment's Own Catalog Token Exists — Discover Its Services
  # Automatically. exposedByDefault Is Always False: Every Service That
  # Should Be Routed Here Opts In Explicitly Via A traefik.enable=true
  # Consul Service Tag.
  consulCatalog:
    endpoint:
      address: "{% if traefik_instance.catalog_env in ['dev', 'prod'] %}{{ resolved_instance_fqdns[0] }}:8501{% else %}localhost:8500{% endif %}"
      token: "{{ _catalog_token_read.stdout }}"
      tls:
        ca: "{{ traefik_base_config_dir }}/{{ traefik_instance.name }}/tls/ca.pem"
    exposedByDefault: {{ traefik_instance.catalog_exposed_by_default | lower }}
    prefix: "traefik"
{% endif %}

certificatesResolvers:
  letsencrypt:
    acme:
      email: "{{ traefik_acme_email }}"
      storage: "{{ traefik_base_config_dir }}/{{ traefik_instance.name }}/acme.json"
{% if traefik_instance.challenge == 'dns-01' %}
      dnsChallenge:
        provider: cloudflare
        resolvers:
          - "1.1.1.1:53"
          - "8.8.8.8:53"
{% else %}
      httpChallenge:
        entryPoint: web
{% endif %}

api:
  dashboard: false

{% if traefik_instance.metrics_port %}
metrics:
  prometheus:
    entryPoint: metrics
{% endif %}