# Managed By Ansible (traefik Role, Instance: {{ traefik_instance.name }}) — Static
# Passthrough Routes. These Never Depend On consulCatalog: Vault/Octopus/
# Grafana (mgmt) And The Nomad/Consul Admin APIs (dev-internal/prod-internal)
# Are All Fixed Backends, Resolved Once At Playbook-Run Time.
#
# Backends With More Than One Resolved Instance (e.g. A 3-Node Prod Raft
# Cluster) List Every Instance As A Separate loadBalancer Server — Any
# One Of Them Can Serve The Admin API, So Whichever Is Reachable During
# A terraform apply Is Enough.

http:
  routers:
{% for route in traefik_instance.static_routes %}
    {{ route.subdomain }}:
      rule: "Host(`{{ route.subdomain }}.{{ traefik_instance.domain }}`)"
      service: {{ route.subdomain }}
      tls:
        certResolver: letsencrypt
{% endfor %}

  services:
{% for route in traefik_instance.static_routes %}
    {{ route.subdomain }}:
      loadBalancer:
        servers:
{% for fqdn in resolved_instance_fqdns %}
          - url: "{{ route.scheme }}://{{ fqdn }}:{{ route.port }}"
{% endfor %}
{% endfor %}
