{
  "Job": {
    "ID": "nginx",
    "Name": "nginx",
    "Type": "service",
    "Datacenters": ["dc1"],
    "TaskGroups": [
      {
        "Name": "web",
        "Count": 1,
        "Networks": [
          {
            "ReservedPorts": [
              {
                "Label": "http",
                "Value": 8080,
                "To": 80
              }
            ]
          }
        ],
        "Tasks": [
          {
            "Name": "nginx",
            "Driver": "docker",
            "Config": {
              "image": "nginx:latest",
              "ports": ["http"]
            },
            "Resources": {
              "CPU": 100,
              "MemoryMB": 128
            }
          }
        ]
      }
    ]
  }
}