# Consul catalog SD for services running in each environemts nomad cluster 
# and static configs for services running on static vms (traefik)


global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  # Node Exporter is tagged with consul service name "node-exporter".
  - job_name: node-exporter
    consul_sd_configs:
      - server: "${CONSUL_HTTP_ADDR}"
        scheme: https
        tls_config:
          ca_file: "${CONSUL_SERVER_CA_FILE}"
          server_name: "client.dc-${ENV}.consul"
        token: "${CONSUL_PROMETHEUS_TOKEN}"
        services: ["node-exporter"]

  # traefik traefik targets with static configs pointing to the traefik vms
  - job_name: traefik-public
    static_configs:
      - targets:
          - "${TRAEFIK_PUBLIC_IP}:${TRAEFIK_PUBLIC_PORT}"
    metrics_path: /metrics

  - job_name: traefik-internal
    static_configs:
      - targets:
          - "${TRAEFIK_INTERNAL_IP}:${TRAEFIK_INTERNAL_PORT}"
    metrics_path: /metrics

  # Every application service (Online Boutique + metrics-api +
  # nomad-sentinel) shares the "metrics" Consul tag — one job here
  # covers all of them rather than one entry per service, so a new
  # boutique service never needs a Prometheus config change to start
  # being scraped.
  - job_name: application-services
    consul_sd_configs:
      - server: "${CONSUL_HTTP_ADDR}"
        scheme: https
        tls_config:
          ca_file: "${CONSUL_SERVER_CA_FILE}"
          server_name: "client.dc-${ENV}.consul"
        token: "${CONSUL_PROMETHEUS_TOKEN}"
        tags: ["metrics"]
    relabel_configs:
      - source_labels: [__meta_consul_service]
        target_label: service

  # NOTE: Two separate tls_config blocks below, for two separate TLS
  # connections this job makes:
  #   - consul_sd_configs.tls_config — the DISCOVERY call, asking
  #     Consul's catalog (localhost:8501) where the "nomad" service
  #     lives. Dials the hostname "localhost", which the cert's SAN
  #     list already covers — no server_name override needed here.
  #   - the job-level tls_config — the actual SCRAPE of whatever
  #     target Consul's catalog returns (the node's real private IP,
  #     e.g. 10.0.1.6). The leaf cert's SAN list only covers
  #     DNS names/wildcards and 127.0.0.1, never real private IPs
  #     (see scripts/generate-and-push-pki.sh), so without server_name here,
  #     TLS identity verification would fail even though the CA and
  #     the cert itself are both genuinely correct.

  # Nomad's own /metrics endpoint, via Consul catalog SD against
  # the "nomad" service. Nomad API is registered as a consul service
  # on the nomad servers.

  - job_name: nomad
    consul_sd_configs:
      - server: "${CONSUL_HTTP_ADDR}"
        scheme: https
        tls_config:
          ca_file: "${CONSUL_SERVER_CA_FILE}"
          server_name: "client.dc-${ENV}.consul"
        token: "${CONSUL_PROMETHEUS_TOKEN}"
        services: ["nomad"]
    scheme: https
    tls_config:
      ca_file: "${CONSUL_SERVER_CA_FILE}"
      server_name: "server.dc-${ENV}.nomad"
    metrics_path: /v1/metrics
    params:
      format: ["prometheus"]

  - job_name: nomad-client
    consul_sd_configs:
      - server: "${CONSUL_HTTP_ADDR}"
        scheme: https
        tls_config:
          ca_file: "${CONSUL_SERVER_CA_FILE}"
          server_name: "client.dc-${ENV}.consul"
        token: "${CONSUL_PROMETHEUS_TOKEN}"
        services: ["nomad-client"]
    scheme: https
    tls_config:
      ca_file: "${CONSUL_SERVER_CA_FILE}"
      server_name: "client.dc-${ENV}.nomad"
    metrics_path: /v1/metrics
    params:
      format: ["prometheus"]

  - job_name: consul
    consul_sd_configs:
      - server: "${CONSUL_HTTP_ADDR}"
        scheme: https
        tls_config:
          ca_file: "${CONSUL_SERVER_CA_FILE}"
          server_name: "client.dc-${ENV}.consul"
        token: "${CONSUL_PROMETHEUS_TOKEN}"
        services: ["consul"]
    scheme: https
    tls_config:
      ca_file: "${CONSUL_SERVER_CA_FILE}"
      server_name: "server.dc-${ENV}.consul"
    metrics_path: /v1/agent/metrics
    params:
      format: ["prometheus"]
